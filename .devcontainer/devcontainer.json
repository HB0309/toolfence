{
  "name": "ToolFence live demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "onCreateCommand": "bash scripts/setup.sh",
  "postStartCommand": "bash scripts/start_live.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "ToolFence dashboard", "onAutoForward": "openBrowser" },
    "8001": { "onAutoForward": "silent" },
    "8082": { "onAutoForward": "silent" }
  },
  "customizations": { "codespaces": { "openFiles": ["README.md"] } }
}
